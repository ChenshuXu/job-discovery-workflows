{
  "schema_version": 1,
  "profile_id": "google-ats-direct",
  "provider": {
    "name": "serpapi-google",
    "endpoint": "https://serpapi.com/search.json",
    "api_key_env": "SERPAPI_API_KEY",
    "engine": "google",
    "google_domain": "google.com",
    "gl": "us",
    "hl": "en",
    "location": "United States",
    "freshness_tbs": "qdr:d",
    "pages_per_query": 1,
    "results_per_page": 10
  },
  "max_post_age_hours": 24,
  "official_fetch_concurrency": 5,
  "http_timeout_ms": 45000,
  "serp_retry_delays_ms": [
    1000,
    4000,
    16000
  ],
  "role_terms": [
    "Software Engineer",
    "Backend Engineer",
    "Backend Software Engineer",
    "Platform Engineer",
    "Infrastructure Engineer",
    "Distributed Systems Engineer",
    "AI Infrastructure Engineer",
    "ML Platform Engineer"
  ],
  "location_terms": [
    "Seattle",
    "Bellevue",
    "Remote",
    "United States"
  ],
  "negative_terms": [
    "intern",
    "frontend"
  ],
  "official_scope": {
    "title_exclusions": [
      {
        "id": "staff",
        "pattern": "\\bstaff\\b",
        "reason": "Staff title is outside the approved target level"
      },
      {
        "id": "principal",
        "pattern": "\\bprincipal\\b",
        "reason": "Principal title is outside the approved target level"
      },
      {
        "id": "management",
        "pattern": "\\b(?:manager|director|head of|vice president|vp)\\b",
        "reason": "Management title is outside the engineering IC target"
      },
      {
        "id": "early-career",
        "pattern": "\\b(?:junior|entry[ -]?level|new grad(?:uate)?|intern(?:ship)?)\\b",
        "reason": "Early-career title is outside the senior target"
      },
      {
        "id": "frontend-fullstack",
        "pattern": "\\b(?:front[ -]?end|full[ -]?stack)\\b",
        "reason": "Frontend/full-stack title is outside the backend/platform target"
      },
      {
        "id": "embedded-mobile",
        "pattern": "\\b(?:embedded|mobile|ios|android)\\b",
        "reason": "Embedded/mobile title is outside the backend/platform target"
      },
      {
        "id": "qa-test",
        "pattern": "\\b(?:quality assurance|qa|sdet|test automation|software engineer in test)\\b",
        "reason": "QA/test title is outside the backend/platform target"
      }
    ],
    "location_allow_patterns": [
      {
        "id": "remote-unspecified",
        "pattern": "^remote$",
        "flags": "i",
        "reason": "Location is explicitly remote without a conflicting region"
      },
      {
        "id": "us-country",
        "pattern": "\\b(?:united states|usa|u\\.s\\.a\\.|u\\.s\\.)\\b|(?:^|[,; ])US(?:$|[,; ])",
        "flags": "i",
        "reason": "Location explicitly identifies the United States"
      },
      {
        "id": "target-metro",
        "pattern": "\\b(?:seattle|bellevue)\\b",
        "flags": "i",
        "reason": "Location is in the configured target metro"
      },
      {
        "id": "us-state-name",
        "pattern": "\\b(?:alabama|alaska|arizona|arkansas|california|colorado|connecticut|delaware|florida|georgia|hawaii|idaho|illinois|indiana|iowa|kansas|kentucky|louisiana|maine|maryland|massachusetts|michigan|minnesota|mississippi|missouri|montana|nebraska|nevada|new hampshire|new jersey|new mexico|new york|north carolina|north dakota|ohio|oklahoma|oregon|pennsylvania|rhode island|south carolina|south dakota|tennessee|texas|utah|vermont|virginia|washington|west virginia|wisconsin|wyoming|district of columbia)\\b",
        "flags": "i",
        "reason": "Location names a U.S. state or district"
      },
      {
        "id": "us-state-code",
        "pattern": "(?:^|[,; ])(?:AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|DC)(?=$|[,; ])",
        "flags": "",
        "reason": "Location contains a U.S. state code"
      }
    ]
  },
  "ats_sites": [
    {
      "id": "ashby",
      "domains": [
        "jobs.ashbyhq.com"
      ]
    },
    {
      "id": "lever",
      "domains": [
        "jobs.lever.co",
        "jobs.eu.lever.co"
      ]
    },
    {
      "id": "greenhouse",
      "domains": [
        "boards.greenhouse.io",
        "job-boards.greenhouse.io"
      ]
    },
    {
      "id": "workday",
      "domains": [
        "myworkdayjobs.com"
      ]
    },
    {
      "id": "smartrecruiters",
      "domains": [
        "jobs.smartrecruiters.com"
      ]
    }
  ],
  "employer_exclusions": [
    {
      "id": "amazon-aws",
      "pattern": "\\b(?:amazon(?:\\s+web\\s+services)?|aws)\\b",
      "reason": "Amazon/AWS employer exclusion"
    },
    {
      "id": "tiktok-bytedance",
      "pattern": "\\b(?:tik\\s*tok|byte\\s*dance)\\b",
      "reason": "TikTok/ByteDance employer exclusion"
    }
  ]
}
