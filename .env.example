# Optional for Google ATS Direct. Keep the actual key only in ignored .env
# or the process environment. Dry-run does not require a key.
SERPAPI_API_KEY=

# Optional executable checkout override. Defaults to sibling ../career-ops.
CAREER_OPS_CODE_ROOT=
# Official private data overrides (otherwise use .career-ops-data or code root).
CAREER_OPS_ROOT=
CAREER_OPS_DATA_DIR=
# Optional tracker override; relative paths are resolved from the code checkout.
CAREER_OPS_TRACKER=
